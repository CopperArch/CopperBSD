#!/bin/sh
# mangowc-session — start MangoWC with QuickShell on FreeBSD.
: "${XDG_RUNTIME_DIR:=/var/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
[ -d "$XDG_RUNTIME_DIR" ] || { mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"; }
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=mangowc
export QT_QPA_PLATFORM=wayland
# keyboard layout picked in the installer (written by first boot)
[ -r /usr/local/etc/copperbsd/keyboard.sh ] && . /usr/local/etc/copperbsd/keyboard.sh
# MangoWC autostarts via its config; also launch QuickShell as the shell.
( sleep 1; quickshell >/tmp/quickshell.log 2>&1 ) &
# the CopperBSD control center, as on the other desktops
( sleep 2; command -v copper-dashboard >/dev/null && copper-dashboard >/dev/null 2>&1 ) &
exec dbus-run-session -- mango
